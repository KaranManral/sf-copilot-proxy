# Salesforce connected-app credentials (client_credentials flow, sfap_api scope).
SF_INSTANCE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# Salesforce Models API base (rarely changed).
SF_MODELS_BASE_URL=https://api.salesforce.com/ai/gpt/v1
SF_FEATURE_ID=ai-platform-models-connected-app
SF_APP_CONTEXT=EinsteinGPT

# Local server bind. Keep host on localhost.
HOST=127.0.0.1
PORT=8787

# Shared secret Copilot must present (as Bearer or x-api-key). Strongly
# recommended so nothing else on the machine can spend your Salesforce quota.
# Leave empty to run open (localhost only).
PROXY_API_KEY=

# Strip the `thinking` block from requests. The Salesforce Bedrock backend
# 502s Sonnet/Opus requests that carry it. Set to 0 only if that is fixed.
STRIP_THINKING=1
